{
 "name": "public-subset",
 "comment": "可对外复现的最小评测子集：自建靶场（examples/demo-app，源码自带缺陷）+ 公开 DSL + 预期标签。10 条常规流程（expect=pass）+ 7 条缺陷检出（expect=fail，复用内部已验证的缺陷探针）。指标定义见 benchmarks/METRICS.md，复现步骤见 README。白屏类缺陷的判据是 explore 的截图灰度判据、不属 DSL 断言，故不在本子集内。",
 "apps": {
  "com.insta.demo": {
   "source": "examples/demo-app（完整 Gradle 工程；源码即为带缺陷版，勿修已标注的缺陷）",
   "build": "gradle :app:assembleDebug → app/build/outputs/apk/debug/app-debug.apk",
   "required_controls": [
    "detail_title",
    "error_text",
    "export_report_btn",
    "export_result",
    "item_text",
    "login_btn",
    "password",
    "search_box",
    "username",
    "welcome_text"
   ],
   "check_controls": "构建安装后 `adb shell uiautomator dump` 或 `mat index` 核对上面这些 id 都存在；缺任何一个说明 App 版本与子集不匹配（子集按当前源码编写）"
  }
 },
 "pass_threshold": 0.6,
 "labels": {
  "pass": "常规流程，应通过",
  "fail": "源码自带缺陷，应失败（通过 = 假绿）"
 },
 "tasks": [
  {
   "id": "demo-f01-login-ok",
   "nl": "打开 demo，输入账号 alice 与密码 pass1234 登录，应进入列表页并显示欢迎文案",
   "case": {
    "caseId": "case_demof01",
    "name": "核心流程：登录成功",
    "target": {
     "package": "com.insta.demo"
    },
    "steps": [
     {
      "id": "s1",
      "intent": "启动",
      "action": "launch",
      "params": {
       "package": "com.insta.demo",
       "cold": true
      }
     },
     {
      "id": "s2",
      "intent": "等登录页",
      "action": "wait",
      "params": {
       "ms": 3000
      }
     },
     {
      "id": "s3",
      "intent": "输入账号",
      "action": "input",
      "target": {
       "strategy": "res-id",
       "value": "com.insta.demo:id/username"
      },
      "params": {
       "text": "alice"
      }
     },
     {
      "id": "s4",
      "intent": "输入密码",
      "action": "input",
      "target": {
       "strategy": "res-id",
       "value": "com.insta.demo:id/password"
      },
      "params": {
       "text": "pass1234"
      }
     },
     {
      "id": "s5",
      "intent": "点登录",
      "action": "tap",
      "target": {
       "strategy": "res-id",
       "value": "com.insta.demo:id/login_btn"
      }
     },
     {
      "id": "s6",
      "intent": "等列表页",
      "action": "wait",
      "params": {
       "ms": 2500
      }
     },
     {
      "id": "s7",
      "intent": "断言欢迎文案含账号名",
      "action": "wait",
      "params": {
       "ms": 300
      },
      "assertions": [
       {
        "type": "text-contains",
        "target": {
         "strategy": "res-id",
         "value": "com.insta.demo:id/welcome_text"
        },
        "expected": "alice"
       }
      ]
     }
    ]
   },
   "expect": "pass"
  },
