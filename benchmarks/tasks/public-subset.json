{
 "name": "public-subset",
 "comment": "可对外复现的最小评测子集：自建靶场（examples/demo-app，源码自带白屏缺陷）+ 公开 DSL + 预期标签。指标定义见 benchmarks/METRICS.md，复现步骤见 README。",
 "apps": {
  "com.insta.demo": {
   "source": "examples/demo-app（完整 Gradle 工程；源码即为带缺陷版，勿修 BlankActivity）",
   "expect_build": "由当前源码构建的 debug APK",
   "reference_apk": {
    "name": "demo-app-broken.apk",
    "sha256": "c70d815b826fbbd7abfca29bbb1f1b412d3df6fadf4ef48aa9dec7e3fde77fb1",
    "note": "参考构建产物，仅用于核对『是否同一棵树』；以你按当前源码构建的结果为准"
   }
  }
 },
 "pass_threshold": 0.7,
 "labels": {
  "pass": "常规流程，应通过",
  "fail": "源码自带缺陷，应失败（通过 = 假绿）"
 },
 "tasks": [
  {
   "id": "demo-f01-login-ok",
   "nl": "打开 demo，输入账号 alice 与密码 pass1234 登录，应进入列表页并显示欢迎文案",
   "case": {
    "caseId": "case_demof01",
    "name": "核心流程：登录成功",
    "target": {
     "package": "com.insta.demo"
    },
    "steps": [
     {
      "id": "s1",
      "intent": "启动",
      "action": "launch",
      "params": {
       "package": "com.insta.demo",
       "cold": true
      }
     },
     {
      "id": "s2",
      "intent": "等登录页",
      "action": "wait",
      "params": {
       "ms": 3000
      }
     },
     {
      "id": "s3",
      "intent": "输入账号",
      "action": "input",
      "target": {
       "strategy": "res-id",
       "value": "com.insta.demo:id/username"
      },
      "params": {
       "text": "alice"
      }
     },
     {
      "id": "s4",
      "intent": "输入密码",
      "action": "input",
      "target": {
       "strategy": "res-id",
       "value": "com.insta.demo:id/password"
      },
      "params": {
       "text": "pass1234"
      }
     },
     {
      "id": "s5",
      "intent": "点登录",
      "action": "tap",
      "target": {
       "strategy": "res-id",
       "value": "com.insta.demo:id/login_btn"
      }
     },
     {
      "id": "s6",
      "intent": "等列表页",
      "action": "wait",
      "params": {
       "ms": 2500
      }
     },
     {
      "id": "s7",
      "intent": "断言欢迎文案含账号名",
      "action": "wait",
      "params": {
       "ms": 300
      },
      "assertions": [
       {
        "type": "text-contains",
        "target": {
         "strategy": "res-id",
         "value": "com.insta.demo:id/welcome_text"
        },
        "expected": "alice"
       }
      ]
     }
    ]
   },
   "expect": "pass"
  },
