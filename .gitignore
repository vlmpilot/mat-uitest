__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.tmp_pytest*/
artifacts/*
# 评测基线必须版本化(守门依据);逐遍产物仍不进
!artifacts/eval
artifacts/eval/*
!artifacts/eval/baseline-*.json
.insta/

# 人工复核结论（mat review 写入）。默认不入库：它记的是**你这台机器上被测 App 的页面标识**，
# 属于本机数据。要留档（团队共享/换机恢复）就把这一行去掉。
review/

# 报告校准规则（mat calibrate 写入）。同上：规则里带着**被测 App 的错误串与日志标记**。
calibration/

# 靶场变体工作目录（make_variants.py 产出：变体源码树 / 产物 / 样本报告）
.variants/
*.log
.DS_Store

# 构建产物（python -m build / pip install -e 生成，不入库）
build/
dist/
*.egg-info/

# Android 构建产物与本地配置（gradle wrapper 本身入库，wrapper 的缓存与 sdk.dir 不入库）
.gradle/
local.properties

# AI prompt 属闭源资产，任意层级不入库（见 README 的 open-core 边界）
*.prompt
.env
deploy.env

# 本地运行产物（SQLite 单文件 + WAL）
*.db
*.db-wal
*.db-shm

# 前端（console/ 后续启用）
node_modules/
console/node_modules/
console/dist/
engine/insta_engine/console_dist/
.coverage
htmlcov/
coverage.xml

# 资产备份包（ops/backup_assets.sh 产出）：内含 prompts_private 与签发私钥的
# AES-256 加密副本。**绝不入库**——一条 `git add -A` 就会把凭据加密包带走并推到
# 远端；口令虽不落盘，但它仍是攻击面，且备份本身属于"本机灾备"而非源码。
ops/backups/

# 按应用的测试说明（用户数据，随工作区走不进 git——同 artifacts/ 口径）
app_notes/
